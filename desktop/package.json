{
  "name": "multichart-desktop",
  "productName": "Multichart",
  "version": "1.0.55",
  "description": "Multichart desktop shell for macOS (bundled site UI + auto-update)",
  "main": "main.js",
  "author": "Multichart",
  "private": true,
  "scripts": {
    "bundle:site": "node scripts/bundle-site.cjs",
    "prestart": "npm run bundle:site",
    "start": "electron .",
    "start:remote": "DESKTOP_REMOTE_UI=1 electron .",
    "start:dev": "DESKTOP_REMOTE_UI=1 CRYPTO_TERMINAL_URL=http://127.0.0.1:8080 electron .",
    "prebuild:mac": "npm run bundle:site",
    "prebuild:mac:publish": "npm run bundle:site",
    "prebuild:win": "npm run bundle:site",
    "prebuild:win:publish": "npm run bundle:site",
    "build:mac": "electron-builder --mac --publish never",
    "build:mac:publish": "electron-builder --mac --publish always",
    "build:win": "electron-builder --win --publish never",
    "build:win:publish": "electron-builder --win --publish always"
  },
  "dependencies": {
    "electron-log": "^5.2.4",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.multichart.desktop",
    "productName": "Multichart",
    "forceCodeSigning": false,
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "asar": true,
    "asarUnpack": [
      "site-bundle/**"
    ],
    "files": [
      "main.js",
      "preload.js",
      "menu-bar-tray.cjs",
      "tray-popup-preload.cjs",
      "tray-popup.html",
      "tray-popup.js",
      "after-pack.cjs",
      "warm-cache.cjs",
      "chrome-user-agent.cjs",
      "platform/**",
      "site-protocol.cjs",
      "local-site-server.cjs",
      "auth-session.cjs",
      "user-store.cjs",
      "trading/**",
      "site-bundle/**"
    ],
    "afterPack": "./after-pack.cjs",
    "mac": {
      "category": "public.app-category.finance",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "dmg": {
      "title": "Multichart ${version}"
    },
    "extraResources": [
      {
        "from": "build/menu-bar-tray.png",
        "to": "menu-bar-tray.png"
      },
      {
        "from": "build/side-dot-long.png",
        "to": "side-dot-long.png"
      },
      {
        "from": "build/side-dot-short.png",
        "to": "side-dot-short.png"
      },
      {
        "from": "../scripts/generate-bybit-pnl-card.py",
        "to": "scripts/generate-bybit-pnl-card.py"
      },
      {
        "from": "../assets/bybit-pnl-template-positive.png",
        "to": "assets/bybit-pnl-template-positive.png"
      },
      {
        "from": "../assets/bybit-pnl-template-negative.png",
        "to": "assets/bybit-pnl-template-negative.png"
      }
    ],
    "publish": {
      "provider": "github",
      "owner": "maximu1234",
      "repo": "crypto-terminal-v2",
      "releaseType": "release"
    },
    "protocols": [
      {
        "name": "Multichart Auth",
        "schemes": [
          "multichart"
        ]
      }
    ]
  }
}
