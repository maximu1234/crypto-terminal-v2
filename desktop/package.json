{
  "name": "multichart-desktop",
  "productName": "Multichart",
  "version": "1.0.23",
  "description": "Multichart desktop shell for macOS (bundled site UI + auto-update)",
  "main": "main.js",
  "author": "Multichart",
  "private": true,
  "scripts": {
    "bundle:site": "node scripts/bundle-site.cjs",
    "prestart": "npm run bundle:site",
    "start": "electron .",
    "start:remote": "DESKTOP_REMOTE_UI=1 electron .",
    "start:dev": "DESKTOP_REMOTE_UI=1 CRYPTO_TERMINAL_URL=http://127.0.0.1:8080 electron .",
    "prebuild:mac": "npm run bundle:site",
    "prebuild:mac:publish": "npm run bundle:site",
    "build:mac": "electron-builder --mac --publish never",
    "build:mac:publish": "electron-builder --mac --publish always"
  },
  "dependencies": {
    "electron-log": "^5.2.4"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.multichart.desktop",
    "productName": "Multichart",
    "forceCodeSigning": false,
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "asar": true,
    "asarUnpack": [
      "site-bundle/**"
    ],
    "files": [
      "main.js",
      "preload.js",
      "after-pack.cjs",
      "warm-cache.cjs",
      "chrome-user-agent.cjs",
      "site-protocol.cjs",
      "local-site-server.cjs",
      "auth-session.cjs",
      "user-store.cjs",
      "trading/**",
      "site-bundle/**"
    ],
    "afterPack": "./after-pack.cjs",
    "mac": {
      "category": "public.app-category.finance",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "dmg": {
      "title": "Multichart ${version}"
    },
    "publish": {
      "provider": "github",
      "owner": "maximu1234",
      "repo": "crypto-terminal-v2",
      "releaseType": "release"
    },
    "protocols": [
      {
        "name": "Multichart Auth",
        "schemes": [
          "multichart"
        ]
      }
    ]
  }
}
