                    array.push(shtPatLines24, ln24)
shtDrawPointBadges() =>
    shtClearPtBadges()
    array<int> qTimes = array.new_int()
    array<float> qPrices = array.new_float()
    array<string> qTexts = array.new_string()
    array<bool> qAboves = array.new_bool()
    array<color> qColors = array.new_color()
    [b1s, pr1s, b2s, pr2s, b3s, pr3s, _b4, _p4] = shtScanAllCompletePatterns()
    int n = array.size(b1s)
    if n > 0
        for i = 0 to n - 1
            if showPt1Badges
                queuePointBadge(qTimes, qPrices, qTexts, qAboves, qColors, array.get(b1s, i), array.get(pr1s, i), "Точка 1", false, color.orange)
            if showPt2Badges
                queuePointBadge(qTimes, qPrices, qTexts, qAboves, qColors, array.get(b2s, i), array.get(pr2s, i), "Точка 2", true, #1565C0)
            if showPt3Badges
                queuePointBadge(qTimes, qPrices, qTexts, qAboves, qColors, array.get(b3s, i), array.get(pr3s, i), "Точка 3", false, #7B1FA2)
    renderQueuedBadges(qTimes, qPrices, qTexts, qAboves, qColors, shtPtBadgeLabels)

if barstate.islast
    if showLongPatterns
        lngDrawPointBadges()
        lngDrawPatternLines()
        lngDrawPt4Dots()
    if showShortPatterns
        shtDrawPointBadges()
        shtDrawPatternLines()
        shtDrawPt4Dots()
