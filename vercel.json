{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/index",
      "destination": "/screener",
      "permanent": false
    },
    {
      "source": "/screener.html",
      "destination": "/screener",
      "permanent": false
    },
    {
      "source": "/coins",
      "destination": "/terminal",
      "permanent": false
    },
    {
      "source": "/terminal.html",
      "destination": "/terminal.html",
      "permanent": false
    },
    {
      "source": "/trade",
      "destination": "/terminal",
      "permanent": false
    },
    {
      "source": "/trade.html",
      "destination": "/terminal.html",
      "permanent": false
    },
    {
      "source": "/script",
      "destination": "/screener",
      "permanent": false
    },
    {
      "source": "/script.html",
      "destination": "/screener.html",
      "permanent": false
    },
    {
      "source": "/diary",
      "destination": "/screener",
      "permanent": false
    },
    {
      "source": "/diary/",
      "destination": "/screener",
      "permanent": false
    }
  ],
  "buildCommand": "node scripts/write-supabase-env.cjs",
  "outputDirectory": ".",
  "headers": [
    {
      "source": "/terminal",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/terminal.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/trade",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/trade.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/js/terminal-page-boot.js",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/javascript; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/js/(.*)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/javascript; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, must-revalidate"
        }
      ]
    },
    {
      "source": "/vendor/(.*)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/javascript; charset=utf-8"
        }
      ]
    }
  ]
}
